# Canonical site URL (production). Always use the non-www apex domain.
# NEXT_PUBLIC_SITE_URL=https://lycheedata.com

# --- Lychee MCP (remote Streamable HTTP at /api/mcp) ---
# Optional override when the public MCP origin differs from the site URL
# (e.g. preview deploy or mcp.lycheedata.com later):
# MCP_PUBLIC_ORIGIN=https://lycheedata.com

# Optional: Google Search Console HTML-tag verification (DNS TXT is already configured for lycheedata.com).
# GOOGLE_SITE_VERIFICATION=your_verification_code

# --- MongoDB ---
# Dev (default for `npm run dev`): MONGODB_URI_DEV=...
# Production (deploy + optional local testing): MONGODB_URI=...
# Point local dev at production DB:
#   npm run dev:prod-db
#   npm run dev -- --prod-db
# Or set USE_PRODUCTION_DB=1 in .env.local (remember to remove when done)

# --- Public bucket (browser fetches S3 HTTPS directly; needs CORS + public read) ---
# NEXT_PUBLIC_DATA_LAKE_BASE_URL=https://YOUR_BUCKET.s3.REGION.amazonaws.com/becker/data/polymarket

# --- Private bucket (recommended): browser calls your Next API; server uses AWS keys ---
# NEXT_PUBLIC_DATA_LAKE_USE_S3_PROXY=true
# DATA_LAKE_S3_BUCKET=becker
# DATA_LAKE_S3_KEY_PREFIX=becker/data/polymarket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# --- Athena (server-side lake SQL; see docs/SERVER_LAKE_ATHENA.md) ---
# `npm run athena:smoke` loads .env then .env.local (local overrides); shell env wins if set.
# Required for scripts/athena-smoke-test.js and future API routes:
# DATA_LAKE_ATHENA_OUTPUT_S3_URI=s3://YOUR_RESULTS_BUCKET/your-prefix/
# Optional:
# DATA_LAKE_ATHENA_WORKGROUP=primary
# DATA_LAKE_ATHENA_CATALOG=AwsDataCatalog
# DATA_LAKE_ATHENA_DATABASE=your_glue_database
# If Kalshi tables are in a different Glue database than Polymarket:
# DATA_LAKE_ATHENA_DATABASE_KALSHI=your_kalshi_database
# DATA_LAKE_ATHENA_SMOKE_SQL=SELECT * FROM your_table LIMIT 5
# Optional: Kalshi `blocks` crawler table if not using default mapping (see athenaTableMap.js)
# DATA_LAKE_ATHENA_TABLE_KALSHI_BLOCKS=blocks_xxxxxxxx
# Optional: max wait for Athena (ms) for /api/data-lake/athena-query
# DATA_LAKE_ATHENA_MAX_WAIT_MS=45000

# --- Stripe ---
# Live keys in production. Local testing uses test keys plus `stripe listen`.
# STRIPE_SECRET_KEY=sk_live_...          # production / STRIPE_LIVE_IN_DEV=true
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_DEV_KEY=sk_test_...      # used automatically when NODE_ENV!==production
# NEXT_PUBLIC_STRIPE_DEV_PUBLISHABLE_KEY=pk_test_...
# STRIPE_LIVE_IN_DEV=true                # optional: force live keys in local next dev
# STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen`, not the Dashboard secret
# Pin live price IDs for current plans (skips lookup-key round trips on cold starts).
# Lite/Pro/Max monthly+annual have empty catalog priceIds today — set these in Vercel:
# STRIPE_PRICE_LITE_MONTHLY=price_...
# STRIPE_PRICE_LITE_WEEKLY=price_...
# STRIPE_PRICE_LITE_ANNUAL=price_...
# STRIPE_PRICE_RESEARCHER_MONTHLY=price_...
# STRIPE_PRICE_RESEARCHER_ANNUAL=price_...
# STRIPE_PRICE_QUANT_MONTHLY=price_...
# STRIPE_PRICE_QUANT_ANNUAL=price_...
# STRIPE_PRICE_IDS={"lite_monthly":"price_...","researcher_monthly":"price_..."}

# --- Telegram alerts (Zora bot @lychee_zora_bot) ---
# TELEGRAM_SECRET_KEY=your_bot_token_from_@BotFather
# TELEGRAM_CHAT_ID=your_chat_or_group_id
# Production only — local/dev never sends. In production, set false to disable.
# TELEGRAM_NOTIFICATIONS_ENABLED=false
# TELEGRAM_TEST_SECRET=optional_production_test_secret

NEXT_PUBLIC_DATA_LAKE_BASE_URL=
NEXT_PUBLIC_DATA_LAKE_USE_S3_PROXY=

# --- X Jarvis (separate app/keys from TWITTER_* / misterrpink1) ---
# Cron hits GET/POST /api/x-jarvis/cron every 5m (see vercel.json).
# X_JARVIS_CRON_SECRET=long_random_secret          # or Vercel CRON_SECRET
# X_JARVIS_LIVE=1                                 # allow posting (omit for dry-run drafts only)
# X_JARVIS_CRON_LIVE=1                            # optional: force live on every cron tick
# X_JARVIS_USERNAME=lychee_data                   # MUST match Access Token owner
# X_JARVIS_USER_ID=                               # optional; resolved from username via Bearer
# Portal → Apps → Keys and tokens → OAuth 1.0a:
# JARVIS_TWITTER_BEARER_TOKEN=                    # Bearer Token
# JARVIS_TWITTER_API_KEY=                         # Consumer Key  (same as "API Key")
# JARVIS_TWITTER_API_KEY_SECRET=                  # Consumer Secret (Reveal / Regenerate)
# JARVIS_TWITTER_ACCESS_TOKEN=                    # Access Token
# JARVIS_TWITTER_ACCESS_SECRET=                   # Access Token Secret (Reveal / Regenerate)
# Inspect: GET /api/x-jarvis/jobs  Authorization: Bearer $X_JARVIS_CRON_SECRET
# Manual tick: GET /api/x-jarvis/cron?live=1&max=5

# --- Polymarket APIs (server: /api/integrations/polymarket) ---
# Defaults match production. For CLOB V2 preview before cutover (~2026-04-28 UTC), try:
# POLYMARKET_CLOB_API_URL=https://clob-v2.polymarket.com
# Optional overrides (trailing slashes are stripped):
# POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
# POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# Client-side Polymarket market WebSocket (FAQ: URLs unchanged for V2; override only if docs change):
# NEXT_PUBLIC_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market