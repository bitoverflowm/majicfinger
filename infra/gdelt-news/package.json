  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.995.0",
    "@aws-sdk/client-iam": "^3.995.0",
    "@aws-sdk/client-lambda": "^3.995.0",
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/client-scheduler": "^3.995.0",
    "@aws-sdk/client-sts": "^3.995.0"
  }
}
