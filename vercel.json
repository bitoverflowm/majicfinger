{
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/x-jarvis/cron",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lycheedata.com" }],
      "destination": "https://lycheedata.com/:path*",
      "permanent": true
    }
  ]
}
